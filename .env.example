# ===========================================================================
# TextHelper environment configuration
# Copy this file to .env.local for local development, or set these as real
# environment variables in your cPanel Node.js application UI for production.
# NEVER commit a real .env / .env.local file. NEVER prefix secrets with
# NEXT_PUBLIC_ - anything with that prefix is sent to the browser.
# ===========================================================================

# --- Site -------------------------------------------------------------------
SITE_URL=https://texthelper.online
NODE_ENV=production

# --- AI provider adapter -----------------------------------------------------
# Currently supported: "groq". The adapter is written so another provider can
# be added later without rewriting tool code (see src/lib/ai/provider.ts).
AI_PROVIDER=groq

# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Verify the current model roster at https://console.groq.com/docs/models
# before launch - Groq's free-tier lineup changes over time (confirmed
# while building this project: llama-3.1-8b-instant, an earlier default,
# had already been retired from the live model list by the time of
# testing). openai/gpt-oss-20b was confirmed working via a real API call
# against this account's GET /openai/v1/models and a real chat completion.
GROQ_MODEL=openai/gpt-oss-20b

# Hard ceiling on characters accepted per AI request (server-enforced).
AI_MAX_INPUT_CHARS=12000

# Hard ceiling on tokens the model may generate per request.
AI_MAX_OUTPUT_TOKENS=1024

# Abort a provider request that takes longer than this (ms).
AI_REQUEST_TIMEOUT_MS=25000

# Site-wide daily budgets, enforced via the on-disk quota store. Set these
# comfortably below your actual Groq free-tier limits (check your console at
# https://console.groq.com/settings/limits - limits vary by model/account).
AI_DAILY_REQUEST_LIMIT=1500
AI_DAILY_TOKEN_LIMIT=400000

# Max AI requests allowed to be in flight at once on this server instance.
AI_CONCURRENCY_LIMIT=4

# Per-IP budgets (simple abuse control; not a substitute for auth).
AI_PER_IP_HOURLY_LIMIT=20

# Directory for the persistent quota ledger, OUTSIDE the public web root.
# The process must have read/write permission to this path.
QUOTA_DATA_DIR=./data/quota

# --- AdSense (disabled by default; never fake these values) -----------------
# ADSENSE_CLIENT_ID is the FULL "ca-pub-XXXXXXXXXXXXXXXX" id from your
# AdSense account (same value used in the <script> tag / data-ad-client).
# /ads.txt is generated automatically from this value at runtime (with the
# "ca-" prefix stripped, per the ads.txt spec) - you do not maintain a
# separate ads.txt file. Before enabling, read your current official Google
# guidance on AdSense policies and on consent requirements for EEA/UK/
# Switzerland visitors (Google's "Privacy & messaging" / Funding Choices
# settings in the AdSense dashboard is the supported way to handle that
# consent UI - this project does not implement a custom consent banner).
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=

# --- Contact form (optional; form degrades to a mailto link if unset) -------
# Point these at your own cPanel email account's SMTP settings, or any SMTP
# provider you already operate. TextHelper does not create or require any
# third-party email service.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Operator details shown on About / Privacy / Terms -----------------------
# These are placeholders until you fill in real details. The launch checklist
# and dev-time console warnings will flag anything left blank.
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_ADDRESS=
